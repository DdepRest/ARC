    (0.95, 0.98, 1.03)

Carbon:

    h = clamp(0.6029 + (ch0 - m0), 0, 1)

    warpFactor = clamp(0.5250 + (ch1 - m1), 0, 1)

    rVal = clamp(0.4512 + (ch2 - m2), 0, 1)

    albedo = clamp(
        0.0108 + h * 0.0056 + warpFactor * 0.0027,
        0.011,
        0.021
    )

    rough = clamp(0.38 + rVal * 0.16, 0.38, 0.54)

    ao = clamp(0.76 + h * 0.24, 0.74, 1.0)

